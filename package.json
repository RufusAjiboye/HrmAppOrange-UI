{
  "name": "hrmapp-ui",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --config=tests/playwright.config.ts",
    "test:ui": "playwright test --config=tests/playwright.config.ts --ui",
    "test:headed": "playwright test --config=tests/playwright.config.ts --headed",
    "test:debug": "playwright test --config=tests/playwright.config.ts --debug",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "report": "playwright show-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check .",
    "check": "npm run typecheck && npm run lint",
    "validate": "npm run typecheck && npm run lint && npm test",
    "install:browsers": "playwright install",
    "postinstall": "playwright install chromium", 
    "test:a11y": "playwright test tests/playwright/e2e/spec/accessibility/hr-orangeapp.accessibility.spec.ts    --config=tests/playwright.config.ts",
    "test:a11y:headed": "playwright test tests/playwright/e2e/spec/accessibility/hr-orangeapp.accessibility.spec.ts --config=tests/playwright.config.ts --headed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.11.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "playwright": "^1.62.1"
  }
}
